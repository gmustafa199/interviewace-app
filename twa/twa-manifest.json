{
  "$schema": "https://json-schema.org/",
  "packageId": "com.interviewace.app",
  "host": "interviewace.unprintables.com",
  "name": "InterviewAce",
  "launcherName": "InterviewAce",
  "display": "standalone",
  "orientation": "default",
  "themeColor": "#0F172A",
  "themeColorDark": "#0F172A",
  "navigationColor": "#0F172A",
  "navigationColorDark": "#0F172A",
  "navigationDividerColor": "#0F172A",
  "navigationDividerColorDark": "#0F172A",
  "backgroundColor": "#0F172A",
  "enableNotifications": true,
  "startUrl": "/?utm_source=twa",
  "iconUrl": "https://interviewace.unprintables.com/icons/icon-512.png",
  "maskableIconUrl": "https://interviewace.unprintables.com/icons/icon-maskable-512.png",
  "monochromeIconUrl": "https://interviewace.unprintables.com/icons/icon-mono-512.png",
  "splashScreenFadeOutDuration": 300,
  "signingKey": {
    "path": "./android.keystore",
    "alias": "android"
  },
  "appVersionName": "1.0.0",
  "appVersionCode": 1,
  "shortcuts": [
    { "name": "Frontend Interview", "shortName": "Frontend", "url": "/?role=frontend&utm_source=shortcut" },
    { "name": "SWE Interview",      "shortName": "SWE",      "url": "/?role=swe&utm_source=shortcut" },
    { "name": "Data Scientist",     "shortName": "Data Sci", "url": "/?role=data-scientist&utm_source=shortcut" }
  ],
  "generatorApp": "bubblewrap-cli",
  "webManifestUrl": "https://interviewace.unprintables.com/manifest.json",
  "fallbackType": "customtabs",
  "features": {
    "locationDelegation": { "enabled": false },
    "playBilling": { "enabled": true }
  },
  "alphaDependencies": { "enabled": false },
  "enableSiteSettingsShortcut": false,
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "fullScopeUrl": "https://interviewace.unprintables.com/",
  "minSdkVersion": 21,
  "_comment": "Replace interviewace.unprintables.com with your real domain (no https:// prefix) before running bubblewrap."
}
